<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SimBoxWeb</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- compila o motor junto (mesmo código dos testes e dos bots) -->
    <Compile Include="..\SimBox.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <EmbeddedResource Include="index.html" LogicalName="index.html" />
  </ItemGroup>
</Project>
